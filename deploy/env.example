# Synthetic lab credentials only. Do not reuse production credentials.
PAYMENT_DB_USERNAME=paysre
PAYMENT_DB_PASSWORD=paysre
CONTROL_DB_USERNAME=paysre
CONTROL_DB_PASSWORD=paysre

# --- AI investigation model ---
# stub = deterministic replay (default); minimax = real LLM investigation.
INVESTIGATION_MODEL=stub
# International endpoint: https://api.minimax.io/v1 (key from platform.minimax.io)
# China mainland endpoint: https://api.minimaxi.com/v1 (key from platform.minimaxi.com)
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M2
# Fill in your own key before switching INVESTIGATION_MODEL to minimax.
MINIMAX_API_KEY=<REPLACE_WITH_YOUR_MINIMAX_API_KEY>
# Raise the per-decision timeout when a real model is enabled, e.g. PT60S.
INVESTIGATION_MODEL_TIMEOUT=PT10S

CHANNEL_SIMULATOR_PORT=8081
PAYMENT_SERVICE_PORT=8080
CONTROL_PLANE_PORT=8082
PROMETHEUS_PORT=9090
LOKI_PORT=3100
TEMPO_PORT=3200
GRAFANA_PORT=3000
